{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "outputDirectory": "public",
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/products", "destination": "/products.html" },
    { "source": "/product-details", "destination": "/product-details.html" },
    { "source": "/cart", "destination": "/cart.html" },
    { "source": "/checkout", "destination": "/checkout.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/register", "destination": "/register.html" },
    { "source": "/orders", "destination": "/orders.html" },
    { "source": "/profile", "destination": "/profile.html" },
    { "source": "/wishlist", "destination": "/wishlist.html" },
    { "source": "/order-success", "destination": "/order-success.html" },
    { "source": "/admin", "destination": "/admin/dashboard.html" },
    { "source": "/admin/dashboard", "destination": "/admin/dashboard.html" },
    { "source": "/admin/products", "destination": "/admin/products.html" },
    { "source": "/admin/categories", "destination": "/admin/categories.html" },
    { "source": "/admin/orders", "destination": "/admin/orders.html" },
    { "source": "/admin/coupons", "destination": "/admin/coupons.html" },
    { "source": "/admin/users", "destination": "/admin/users.html" }
  ]
}
